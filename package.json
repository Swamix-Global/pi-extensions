{
  "name": "pi-extensions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pi extension workspace: one npm package per extension, each self-contained and built to a single-file bundle under build/.",
  "workspaces": [
    "questionnaire",
    "sgai-formatter",
    "tool-scripting",
    "tool-search",
    "tool-subagentx",
    "util-compaction",
    "quota-helper",
    "util-frankenstein"
  ],
  "scripts": {
    "build": "bash scripts/build-all.sh",
    "install:pi": "bash install.sh"
  },
  "engines": {
    "node": ">=22"
  }
}