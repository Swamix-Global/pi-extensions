{
  "name": "@sgai/pi-tool-bash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "tool-bash: Display-first bash tool override for Pi: named commands, bounded timeouts, pid/poll/kill handoff, full logs.",
  "keywords": [
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "build/tool-bash.js"
    ]
  },
  "scripts": {
    "build": "bash ../../scripts/build-extension.sh tool-bash"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
